{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "./src",
    "outDir": "./dist",
    "typeRoots": ["./node_modules/@types", "src/@types"],
    "lib": ["ES2020"],
    "paths": {
      "@/*": ["./src/*"],
      "*": ["./node_modules/*", "./src/@types/*"]
    },
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },

  "include": ["src"]
}